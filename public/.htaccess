# ============================================================================
# FLYX INSIGHT PRODUCTION APACHE CONFIGURATION (.htaccess)
# Domain: https://flyxinsight.flyxcoin.com (Hostinger Production Deployment)
# Backend: PHP + MySQL Native API Architecture
# ============================================================================

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, x-csrf-token, X-Requested-With, Accept, Origin"
</IfModule>

# Handle HTTP OPTIONS Preflight requests
RewriteEngine On
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=204,L]

# 1. Native PHP API Routing for Hostinger
# Direct /api/overview, /api/price, and dynamic /api endpoints to PHP handlers
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/overview/?$ api/overview.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/price/?$ api/price.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/(.*)$ api/index.php?endpoint=$1 [QSA,L]

# 2. Single Page Application (SPA) Client Routing
# Direct all non-existent frontend paths to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
