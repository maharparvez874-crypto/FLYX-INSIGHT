# ============================================================================
# FLYX INSIGHT PRODUCTION APACHE CONFIGURATION (.htaccess)
# Domain: https://flyxinsight.flyxcoin.com
# ============================================================================

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, x-csrf-token, X-Requested-With, Accept, Origin"
</IfModule>

# Handle HTTP OPTIONS Preflight requests
RewriteEngine On
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=204,L]

# 1. Reverse Proxy to Node.js / Express on port 3000 if mod_proxy is enabled
<IfModule mod_proxy.c>
    <IfModule mod_proxy_http.c>
        RewriteCond %{HTTP_HOST} ^(flyxinsight\.flyxcoin\.com|localhost|127\.0\.0\.1) [NC]
        RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]
    </IfModule>
</IfModule>

# 2. Native PHP API Routing Fallback for LAMP / Hostinger Shared Hosting
# Directs /api/overview and /api/price to PHP handlers if Node proxy is not running
RewriteCond %{REQUEST_URI} ^/api/overview/?$ [NC]
RewriteRule ^api/overview/?$ api/overview.php [L]

RewriteCond %{REQUEST_URI} ^/api/price/?$ [NC]
RewriteRule ^api/price/?$ api/price.php [L]

RewriteCond %{REQUEST_URI} ^/api/(.*)$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/(.*)$ api/index.php?endpoint=$1 [QSA,L]

# 3. Single Page Application (SPA) Client Routing
# Redirects all non-existent files and directories to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
